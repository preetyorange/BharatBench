*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
report_body.tex
gen_report_part*.py
generate_report.py

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Test/debug scripts
test_coords.py
test_geojson.py
